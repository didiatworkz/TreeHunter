# Generate once with:
# docker compose run --rm --entrypoint php app artisan key:generate --show
APP_KEY=

# Local setup uses http://localhost:8080. Use your public HTTPS URL when deployed.
APP_URL=http://localhost:8080
APP_PORT=8080
APP_NAME=TreeHunter

# Docker Hub image to run. Pin this to a sha-... tag for repeatable deployments.
TREEHUNTER_IMAGE=atworkz/treehunter:latest

# Keep true only while new users should be able to register.
REGISTRATION_ENABLED=true
SESSION_SECURE_COOKIE=false

# SQLite is the standalone default. Its database is stored in the Docker volume.
DB_CONNECTION=sqlite
DB_DATABASE=

# Optional external MySQL or MariaDB configuration. Set DB_CONNECTION=mysql or mariadb,
# then provide all values below. Do not leave credentials in this example in production.
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=

# The container applies migrations at startup. Set false only if migrations run elsewhere.
AUTO_MIGRATE=true

# Optional SMTP settings. Leave MAIL_MAILER=log for local setup.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=TreeHunter
